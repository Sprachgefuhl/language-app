<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="show">
    <div class="main">
      <div class="card">
        <div class="card-header">
          <i class="fa-regular fa-folder-open"></i>
          <h1 class="card-header-title">Cards</h1>

          <div class="card-header-right">
            <p id="card-count">
              <%= deck.cards.length %>
            </p>

            <a href="/decks">
              <i class="fa-solid fa-arrow-left card-header-right-icon"></i>
            </a>
          </div>
        </div>

        <div class="card-content">  
          <% deck.cards.forEach(card => { %>
            <div class="card-item">
              <p class="card-item-title"><%= card.front %> | <%= card.back %></p>

              <div class="card-item-right">
                <a href="/decks/<%= deck.id %>/card/edit/<%= card.id %>">
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>

                <!-- <a class="delete-card" data-cardid="<%= card.id %>">
                  <i class="fa-solid fa-trash-can"></i>
                </a> -->
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <script>
    const deleteCardEl = document.querySelector('.delete-card');
    const cardId = deleteCardEl.dataset.cardid;

    deleteCardEl.addEventListener('click', () => {
      fetch(`/card/delete/${cardId}?_method=DELETE`, { method: 'post' })
        .then(res => window.location = res.url);
    });
  </script>
</body>
</html>