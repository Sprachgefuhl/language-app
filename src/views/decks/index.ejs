<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="decks">
    <div class="main">
      <div class="card">
        <div class="card-header">
          <i class="fa-regular fa-folder-open"></i>
          <h1 class="card-header-title">Decks</h1>

          <a class="card-header-right" href="/decks/create">
            <i class="fa-solid fa-plus card-header-right-icon"></i>
            <p>Deck</p>
          </a>
        </div>

        <div class="card-content">
          <% if (decks.length) { %>
            <% decks.forEach(deck => { %>
              <div class="card-item">
                <a href="/decks/review/<%= deck.id %>">
                  <p class="card-item-title"><%= deck.name %></p>
                </a>

                <div class="card-item-right">
                  <p id="review-count">
                    <%= dueCardsPerDeck.find(item => item.deckId === deck.id).totalCardsDue; %>
                  </p>
                  <!-- <a href="/decks/show/<%= deck.id %>">
                    <i class="fa-regular fa-folder-open"></i>
                  </a> -->
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="nothing">
              <p>No decks created</p>
            </div>
          <% } %>
        </div>

        <% if (decks.length) { %>
          <div class="open-overlay">
            <i class="fa-solid fa-circle-plus"></i>
            <p>Card</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="create-card">
    <div class="overlay hidden">
      <div class="main">
        <div class="card" id="flashcard-overlay">
          <div class="card-header">
            <i class="fa-regular fa-file card-header-icon"></i>
            <h1 class="card-header-title">Flashcard</h1>

            <div class="card-header-right" id="create-card-btn">
              <i class="fa-regular fa-square-plus card-header-right-icon"></i>
              <p>Create</p>
            </div>
          </div>

          <div class="card-content">
            <div class="card-item">
              <p class="card-item-title">Front</p>
              <input type="text" id="front" name="front">
            </div>

            <div class="card-item">
              <p class="card-item-title">Back</p>
              <input type="text" id="back" name="back">
            </div>
            
            <div class="card-item">
              <p class="card-item-title">Deck</p>
              <select name="deck" id="deck" class="dropdown">
                <% decks.forEach(deck => { %>
                  <option value="<%= deck.id %>"><%= deck.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="card-item">
              <p class="card-item-title">Language</p>
              <select name="language" id="language" class="dropdown">
                <% langData.forEach(lang => { %>
                  <option value="<%= lang.code %>"><%= lang.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="card-item">
              <p class="card-item-title">Native Audio</p>
              <div class="find-audio">
                <i class="fa-regular fa-file-audio"></i>
                <p>Generate</p>
              </div>
            </div>

            <button id="play" style="display: none;">Play</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const overlayEl = document.querySelector('.overlay');

    document.querySelector('.open-overlay').addEventListener('click', () => {
      overlayEl.classList.remove('hidden');

      overlayEl.addEventListener('click', (e) => {
        const cardEl = document.getElementById('flashcard-overlay');
        if (!cardEl.contains(e.target)) overlayEl.classList.add('hidden');
      });
    });

    document.getElementById('create-card-btn').addEventListener('click', async () => {
      try {
        const frontEl = document.getElementById('front');
        const backEl = document.getElementById('back');
        const deckId = document.getElementById('deck').value;

        showStatus('Creating...', 'info');
        const res = await fetch(`/decks/${deckId}/create-card`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            front: frontEl.value.trim(),
            back: backEl.value.trim()
          })
        });

        const result = await res.json();
        if (result.msg === 'Card created') {
          showStatus(result.msg, 'success');
          window.location.reload();
        } else showStatus(result.msg, 'error');
      } catch (err) {
        console.error(err);
        alert('Something went wrong. Please try again.');
      }
    });
  
    document.querySelector('.find-audio').addEventListener('click', async () => {
      try {
        const frontEl = document.getElementById('front');
        const langCode = document.getElementById('language').value;

        showStatus('Finding audio...', 'info');
        const res = await fetch('decks/card/native-audio', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            front: frontEl.value.trim().toLowerCase(),
            langCode: langCode,
          })
        });

        const result = await res.json();

        if (result.msg === 'Audio found') {
          showStatus(result.msg, 'success');
          const audio = new Audio(result.audio);
          document.getElementById('play').style.display = 'block';
          document.getElementById('play').addEventListener('click', () => {
            audio.play();
          });
        } else showStatus(result.msg, 'error');
      } catch (err) {
        console.error(err);
        alert('Something went wrong. Please try again.');
      }
    })
  </script>
</body>
</html>