<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="review">
    <div class="main">
      <div class="card">
        <div class="card-header">
          <i class="fa-solid fa-bolt"></i>
          <h1 class="card-header-title"><%= deck.name %> review</h1>
          <!-- <p id="review-count"><%= totalDue %></p> -->

          <div class="card-header-right">
            <a href="/decks">
              <i class="fa-solid fa-arrow-left card-header-right-icon"></i>
            </a>
          </div>
        </div>

        <div class="card-content">
          <% if (!card) { %>
            <div class="nothing">
              <p>No cards due for review</p>
            </div>
          <% } else { %>
            <div class="flashcard" data-deck="<%= JSON.stringify(deck) %>" data-card="<%= JSON.stringify(card) %>">
              <div class="flashcard-top">
                <span class="flashcard-top-header">front</span>
                <p class="flashcard-top-body" id="front"></p>
              </div>

              <div class="flashcard-bottom">
                <div class="answer success">
                  <i class="fa-regular fa-circle-check" id="success"></i>
                </div>

                <div class="answer fail">
                  <i class="fa-regular fa-circle-xmark" id="fail"></i>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script>
    const flashcard = document.querySelector('.flashcard');
    const header = document.querySelector('.flashcard-top-header');
    const content = document.getElementById('front');
    const answerBtns = document.querySelectorAll('.answer');
    const deck = JSON.parse(flashcard.dataset.deck);
    const card = JSON.parse(flashcard.dataset.card);
    content.textContent = card.front;

    async function handleAnswer(e) {
      // console.log(e.target.classList)
      const result = e.target.classList[1];
      header.textContent = '';
      content.textContent = card.back;
      answerBtns[1].style.display = 'none';
      answerBtns[0].style.background = '#60A5FA';
      let newBtn = answerBtns[0].children[0];
      newBtn.classList = 'fa-regular fa-circle-right';
      newBtn.id = '';
      
      answerBtns[0].addEventListener('click', async () => fetchReview(result));
    }

    async function fetchReview(answer) {
      const success = answer === 'success' ? true : false;

      try {
        const res = await fetch(`/decks/review/:${deck.id}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ deck: deck, card: card, success: success })
        });

        const result = await res.json();
        if (result.msg === 'Card reviewed') window.location.reload();
      } catch (err) {
        console.error(err);
        alert('Something went wrong. Please try again.');
      }
    }

    // answerBtns.forEach(btn => btn.addEventListener('click', (e) => handleAnswer(e)));
  </script>
</body>
</html>