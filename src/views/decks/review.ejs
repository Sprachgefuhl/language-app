<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="review">
    <div class="main">
      <div class="card">
        <div class="card-header">
          <i class="fa-solid fa-bolt"></i>
          <h1 class="card-header-title">Review</h1>
          <div id="card-state">
            <p></p>
          </div>
          <!-- <p id="review-count"><%= totalDue %></p> -->

          <div class="card-header-right">
            <a href="/decks">
              <i class="fa-solid fa-arrow-left card-header-right-icon"></i>
            </a>
          </div>
        </div>

        <div class="card-content">
          <% if (!card) { %>
            <div class="nothing">
              <p>No cards due for review</p>
            </div>
          <% } else { %>
            <div class="flashcard" data-card="<%= JSON.stringify(card) %>">
              <div class="flashcard-top">
                <span class="flashcard-top-header">front</span>
                <div class="flashcard-top-content">
                  <p class="flashcard-top-content-body" id="front"></p>
                  <i class="fa-solid fa-volume-high" id="audio-el"></i>
                </div>
              </div>

              <div class="flashcard-bottom">
                <div class="answer success">
                  <i class="fa-regular fa-circle-check" id="success"></i>
                </div>

                <div class="answer fail">
                  <i class="fa-regular fa-circle-xmark" id="fail"></i>
                </div>

                <div class="answer continue">
                  <i class="fa-regular fa-circle-right"></i>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script>
    const flashcard = document.querySelector('.flashcard');
    const stateEl = document.getElementById('card-state');
    const header = document.querySelector('.flashcard-top-header');
    const content = document.getElementById('front');
    const audioEl = document.getElementById('audio-el');
    const successBtn = document.querySelector('.success');
    const failBtn = document.querySelector('.fail');
    const continueBtn = document.querySelector('.continue');
    const card = JSON.parse(flashcard.dataset.card);
    const states = {
      new: { colour: '#60A5FA' },
      learning: { colour: '#FB923C' },
      mature: { colour: '#C084FC' },
      relearning: { colour: '#F87171' }
    };
    let audio;

    if (card.audio) {
      audio = new Audio(card.audio);
    }

    const stateColour = states[card.state].colour;
    stateEl.style.display = 'flex';
    stateEl.textContent = card.state;
    stateEl.style.color = stateColour;
    content.textContent = card.front;

    async function handleAnswer(answer) {
      console.log('hey');
      header.textContent = '';
      content.textContent = card.back;

      if (audio) {
        audioEl.style.display = 'flex';
        audio.play(); // autoplay

        audioEl.addEventListener('click', () => {
          audio.pause();
          audio.currentTime = 0;
          audio.play();
        });
      }

      failBtn.style.display = 'none';
      successBtn.style.display = 'none';
      continueBtn.style.display = 'block';
      continueBtn.addEventListener('click', async () => fetchReview(answer));
    }

    async function fetchReview(answer) {
      const success = answer === 'success' ? true : false;
      showStatus('Updating...', 'load');
      
      try {
        const res = await fetch(`/decks/review/:${card.id}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ card: card, success: success })
        });

        const result = await res.json();
        if (result.msg === 'Card reviewed') {
          showStatus('Updated', 'success');
          window.location.reload();
        }
      } catch (err) {
        console.error(err);
        alert('Something went wrong. Please try again.');
      }
    }

    successBtn.addEventListener('click', () => handleAnswer('success'));
    failBtn.addEventListener('click', () => handleAnswer('fail'));
  </script>
</body>
</html>