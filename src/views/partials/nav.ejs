<div class="nav">
  <a href="/profile/edit/language">
    <div class="nav-el">
      <% if (!currentUser.current_language) { %>
        <i id="unselected-lang-icon" class="fa-solid fa-earth-europe"></i>
      <% } else { %>
        <img src="/images/<%= currentUser.current_language %>.png" width="45">
      <% } %>
    </div>
  </a>

  <div class="nav-center">

    <a href="/text">
      <div class="nav-el">
        <i class="fa-solid fa-book-open"></i>
        <p>Text</p>
      </div>
    </a>

    <a href="/decks">
      <div class="nav-el">
        <i class="fa-solid fa-bolt"></i>
        <p>Decks</p>
      </div>
    </a>

    <% if (currentUser.role==='admin' ) { %>
      <a href="/admin/users">
        <div class="nav-el">
          <i class="fa-solid fa-user-group"></i>
          <p>Users</p>
        </div>
      </a>
    <% } %>

    <a href="/profile/show">
      <div class="nav-el">
        <i class="fa-regular fa-circle-user"></i>
        <p id="first-name">
          <%= currentUser.first %>
        </p>
      </div>
    </a>

  </div>

  <div class="nav-el" id="logout-btn">
    <i class="fa-solid fa-right-from-bracket"></i>
    <p>Logout</p>
  </div>
</div>

<script>
  const logoutEl = document.getElementById('logout-btn');

  logoutEl.addEventListener('click', () => {
    fetch('/logout?_method=DELETE', { method: 'post' })
      .then(res => window.location = res.url);
  });
</script>