<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="users">
    <div class="main">
      <div class="card">

        <div class="card-header">
          <i class="fa-solid fa-user-group card-header-icon"></i>
          <h1 class="card-header-title">Users</h1>

          <a class="card-header-right" href="/admin/users/create">
            <i class="fa-solid fa-plus card-header-right-icon"></i>
            <p>Create</p>
          </a>
        </div>

        <div class="card-content">
          <% users.forEach(user=> { %>
            <div class="card-item">
              <div class="card-item-title"><i class="fa-regular fa-address-card"></i></div>
              <a href="/admin/users/show/<%= user.id %>">
                <p><%= user.first %> <%= user.last %></p>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>