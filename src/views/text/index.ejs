<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="daily-text">
    <div class="text-main">
      <div class="content">
        <div class="header">
          <h2 id="text-date">
            <i class="fa-solid fa-circle-chevron-left" id="day-before"></i>
            <%= date %>
            <i class="fa-solid fa-circle-chevron-right" id="day-after"></i>
          </h2>
        </div>
        <div class="text">
          <% if (!archive.length) { %>
            <p style="word-spacing: normal;">Daily text unavailable</p>
          <% } else { %>

            <% archive[0].alignments.forEach((alignment, i) => { %>
              <div class="alignment" id="<%= i %>">
                <span class="eng" style="display: none;"><%= alignment.eng %></span>
                <span class="target"><%= alignment.target %></span>
              </div>
            <% }); %>

          <% } %>
        </div>

        <div class="create-card">

          <div class="open-overlay">
            <i class="fa-solid fa-circle-plus"></i>
          </div>

          <div class="overlay hidden">
            <div class="main"> 
              <div class="card">
                <div class="card-header">
                  <i class="fa-regular fa-file card-header-icon"></i>
                  <h1 class="card-header-title">Flashcard</h1>

                  <div class="card-header-right" id="create-card-btn">
                    <i class="fa-regular fa-square-plus card-header-right-icon"></i>
                    <p>Create</p>
                  </div>
                </div>

                <div class="card-content">
                  <div class="card-item">
                    <p class="card-item-title">Front</p>
                    <input type="text" id="front" name="front">
                  </div>

                  <div class="card-item">
                    <p class="card-item-title">Back</p>
                    <input type="text" id="back" name="back">
                  </div>

                  <div class="card-item">
                    <p class="card-item-title">Deck</p>
                    <select name="deck" id="deck">
                      <% decks.forEach(deck => { %>
                        <option value="<%= deck.id %>"><%= deck.name %></option>
                      <% }); %>
                    </select>
                  </div>

                  <div class="card-status">
                    <p id="status"></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/text.js"></script>
</body>
</html>