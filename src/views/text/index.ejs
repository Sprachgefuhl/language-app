<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="daily-text">
    <div class="main">
      <div class="content">
        <div class="text">
          <div class="header">
            <h2 id="text-date">
              <i class="fa-solid fa-circle-chevron-left" id="day-before"></i>
              <%= date %>
              <i class="fa-solid fa-circle-chevron-right" id="day-after"></i>
            </h2>
          </div>
          <div class="card text-card">
            <% if (!dailyText.length) { %>
              <p style="word-spacing: normal;">Select your language to get started!</p>
            <% } else { %>

              <% dailyText.split(' ').forEach(word => { %>
                <span class="word"><%= word %></span>
              <% }); %>

            <% } %>
          </div>
        </div>
        
        <div class="translate">
          <div class="header">
            <h2 id="translate-title">Translate</h2>
          </div>
          <div class="card translate-card">
            <div class="translate-card-chunk">
              <p class="translate-card-header">Chunk</p>
              <p id="selected"></p>
            </div>

            <div class="translate-card-result">
              <p class="translate-card-header">Translation</p>
              <p id="result"></p>
            </div>

            <div class="translate-card-flashcard">
              <i class="fa-solid fa-language" id="translate-btn"></i>

              <div class="select-deck">
                <% if (!decks.length) { %>
                  <p>No decks</p>
                <% } else { %>
                  <select name="select-deck" id="select-deck">
                    <% decks.forEach(deck => { %>
                      <option value="<%= deck.id %>"><%= deck.name %></option>
                    <% }); %>
                  </select>
                <% } %>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/text.js"></script>
</body>
</html>