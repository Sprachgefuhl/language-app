<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="daily-text">
    <div class="main">
      <div class="content">
        <div class="text">
          <div class="header">
            <h2 id="text-date">
              <i class="fa-solid fa-circle-chevron-left" id="day-before"></i>
              <%= date %>
              <i class="fa-solid fa-circle-chevron-right" id="day-after"></i>
            </h2>
          </div>
          <div class="card text-con">
            <% if (!dailyText.length) { %>
              <p style="word-spacing: normal;">Select your language to get started!</p>
            <% } else { %>

              <% dailyText.split(' ').forEach(word => { %>
                <span class="word"><%= word %></span>
              <% }); %>

            <% } %>
          </div>
        </div>
        
        <div class="learn">
          <h2 class="header">Research</h2>
          <div class="card">
            <i class="fa-solid fa-book" id="research-btn"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/text.js"></script>
</body>
</html>