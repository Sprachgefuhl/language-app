<%- include('../partials/head') %>
<body>
  <div class="login">
    <div class="main">
      <div class="card">
        
        <div class="card-header">
          <i id="icon-status" class="fa-solid fa-user-lock card-header-icon"></i>
          <h1 class="card-header-title">Login</h1>

          <div class="card-header-right" id="login-btn">
            <i class="fa-solid fa-arrow-right-to-bracket card-header-right-icon"></i>
            <p>Login</p>
          </div>
        </div>

        <div class="card-content">
          <div class="card-item">
            <i class="fa-solid fa-envelope card-item-title"></i>
            <input type="email" name="email" id="email" placeholder="email" autocomplete="off">
          </div>

          <div class="card-item">
            <i class="fa-solid fa-lock card-item-title"></i>
            <input type="password" name="password" id="password" placeholder="password" autocomplete="off">
          </div>

          <div class="card-status">
            <p id="status"></p>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    const statusEl = document.getElementById('status');
    const iconStatusEl = document.getElementById('icon-status');

    document.getElementById('login-btn').addEventListener('click', async () => {
      const [email, password] = ['email', 'password'].map(id => document.getElementById(id).value)

      try {
        statusEl.textContent = 'Logging in...';

        const res = await fetch('/login/auth', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email: email, password: password })
        });

        const result = await res.json();
        if (result.msg === 'Successfully logged in') {
          iconStatusEl.classList = 'fa-solid fa-lock-open';
          return window.location.reload();
        } else {
          statusEl.textContent = result.msg;
        }
      } catch (err) {
        console.error(err);
        alert('Something went wrong. Please try again.');
      }
    });
  </script>
</body>
</html>