<%- include('../partials/head') %>

  <body>
    <%- include('../partials/nav') %>
      <div class="users">


        <div class="main">
          <div class="card">
            <div class="card-header">
              <i class="fa-solid fa-user-group"></i>
              <h1>Users</h1>

              <a class="card-header-right" href="/admin/users/new">
                <i class="fa-solid fa-plus"></i>
                <p>Create</p>
              </a>
            </div>

            <div class="card-content">
              <% users.forEach(user=> { %>
                <div class="card-item">
                  <div class="card-item-title"><i class="fa-regular fa-address-card"></i></div>
                  <a href="/admin/users/show/<%= user.id %>">
                    <p>
                      <%= user.first %>
                        <%= user.last %>
                    </p>
                  </a>
                  <!-- <i class="fa-solid fa-trash-can" id="delete-icon" onclick="deleteUser('<%= user.unsubscribe_token %>')"></i> -->
                </div>
                <% }) %>
            </div>
          </div>
        </div>
      </div>

      <!-- <a href="/"><i class="fa-solid fa-arrow-left"></i>Back</a> -->

      <script src="/js/admin/users.js"></script>
  </body>

  </html>