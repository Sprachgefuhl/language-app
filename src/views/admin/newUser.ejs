<%- include('../partials/head') %>

  <body>
    <%- include('../partials/nav') %>
      <div class="create-user">
        <div class="main">
          <div class="card">
            <div class="card-header">
              <i class="fa-regular fa-user"></i>
              <h1>Create</h1>
              <button class="card-header-right" type="submit" form="create-user-form">
                <i class="fa-regular fa-floppy-disk"></i>
                <p>Save</p>
              </button>
            </div>

            <div class="card-content">
              <form id="create-user-form" action="/admin/users/new" method="post">

                <div class="card-item">
                  <p class="card-item-title">First</p>
                  <input type="text" id="first" name="first" placeholder="first" required>
                </div>

                <div class="card-item">
                  <p class="card-item-title">Last</p>
                  <input type="text" id="last" name="last" placeholder="last" required>
                </div>

                <div class="card-item">
                  <p class="card-item-title">Email</p>
                  <input type="email" id="email" name="email" placeholder="email" required>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
      </div>
  </body>

  </html>