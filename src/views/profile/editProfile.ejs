<%- include('../partials/head') %>

  <body>
    <%- include('../partials/nav') %>
      <div class="edit-profile">
        <div class="main">
          <div class="card">
            <div class="card-header">
              <i class="fa-regular fa-circle-user"></i>
              <h1>Edit</h1>
              <button class="card-header-right" type="submit" form="edit-form">
                <i class="fa-regular fa-floppy-disk"></i>
                <p>Save</p>
              </button>
            </div>

            <div class="card-content">
              <form id="edit-form" action="/profile/edit" method="post">

                <div class="card-item">
                  <p class="card-item-title">First</p>
                  <input type="text" id="first" name="first" value="<%= currentUser.first %>" required>
                </div>

                <div class="card-item">
                  <p class="card-item-title">Last</p>
                  <input type="text" id="last" name="last" value="<%= currentUser.last %>" required>
                </div>

                <div class="card-item">
                  <p class="card-item-title">Password</p>
                  <input type="password" id="password" name="password" placeholder="Leave blank to keep"
                    autocomplete="new-password">
                </div>

                <div class="card-item">
                  <p class="card-item-title">Repeat</p>
                  <input type="password" id="repeat" name="repeat">
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
  </body>

  </html>