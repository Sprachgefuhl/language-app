<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>
  <div class="show-profile">
    <div class="main">
      <div class="card">

        <div class="card-header">
          <i class="fa-regular fa-circle-user card-header-icon"></i>
          <h1 class="card-header-title">Profile</h1>

          <a class="card-header-right" href="/profile/edit">
            <i class="fa-solid fa-pen-to-square card-header-right-icon"></i>
            <p>Edit</p>
          </a>
        </div>

        <div class="card-content">
          <div class="card-item">
            <p class="card-item-title">Name</p>
            <p><%= currentUser.first %> <%= currentUser.last %></p>
          </div>

          <div class="card-item">
            <p class="card-item-title">Email</p>
            <p><%= currentUser.email %></p>
          </div>

          <div class="card-item">
            <p class="card-item-title">Role</p>
            <p><%= currentUser.role %></p>
          </div>

          <div id="logout">
            <p>Logout</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const logoutEl = document.getElementById('logout');

    logoutEl.addEventListener('click', () => {
      fetch('/logout?_method=DELETE', { method: 'post' })
        .then(res => window.location = res.url);
    });
</script>
</body>
</html>